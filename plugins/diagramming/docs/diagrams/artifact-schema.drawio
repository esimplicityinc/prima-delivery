<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="prima-delivery/diagramming" version="1.0">
  <diagram id="e61b60f6c02f486c" name="RIC-401 Appendix F — Artifact Schema (ERD)">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="top_callout" value="ARTIFACT SCHEMA — every node in the Katalyst taxonomy carries these fields.&lt;br/&gt;Lineage (supersedes), authority (owner role), dimension (Need / Design Intent / Implementation Reality), and hypothesis annotation are the four load-bearing relationships." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1780" height="70" as="geometry" /></mxCell>
        <mxCell id="artifact" value="Artifact&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• type (UT | US | ADR | NFR | PRD | mockup | ...)&lt;br/&gt;• title&lt;br/&gt;• version (semver-ish: 1.0, 1.1, 2.0)&lt;br/&gt;• status (DRAFT | APPROVED | SUPERSEDED | DEPRECATED)&lt;br/&gt;• created_at&lt;br/&gt;• last_modified&lt;br/&gt;• supersedes_id (FK → Artifact.id, nullable)&lt;br/&gt;• dimension_id (FK → TaxonomyDimension.id)&lt;br/&gt;• loop_id (FK → Loop.id)&lt;br/&gt;• owner_authority_id (FK → Authority.id)&lt;br/&gt;• hypothesis_id (FK → Hypothesis.id, nullable)&lt;br/&gt;• body (markdown / yaml content)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=3;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="420" height="380" as="geometry" /></mxCell>
        <mxCell id="hypothesis" value="Hypothesis&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• claim (&quot;we believe X&quot;)&lt;br/&gt;• success_metrics (&quot;right when Y&quot;)&lt;br/&gt;• kill_criteria (&quot;by date Z&quot;)&lt;br/&gt;• status (DRAFT | ACTIVE | CONFIRMED | REFUTED | PARTIAL | EXTRACTED | KILLED | REFINED)&lt;br/&gt;• created_at&lt;br/&gt;• decided_at (nullable until terminal state)&lt;br/&gt;• evidence_refs[] (FK → Evidence.id)&lt;br/&gt;• loop_id (FK → Loop.id)&lt;br/&gt;• owner_authority_id (FK → Authority.id)&lt;br/&gt;• related_artifact_ids[] (FK → Artifact.id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff9c4;strokeColor=#f57f17;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="420" height="380" as="geometry" /></mxCell>
        <mxCell id="evidence" value="Evidence&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• type (interview | metric | observation | analytics | survey)&lt;br/&gt;• date&lt;br/&gt;• summary&lt;br/&gt;• ref_url (link to source: dashboard, transcript, report)&lt;br/&gt;• hypothesis_id (FK → Hypothesis.id)&lt;br/&gt;• collected_by_authority_id (FK → Authority.id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="160" width="380" height="280" as="geometry" /></mxCell>
        <mxCell id="outcome" value="HypothesisOutcome (annotation)&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• hypothesis_id (FK → Hypothesis.id)&lt;br/&gt;• status (CONFIRMED | REFUTED | PARTIAL)&lt;br/&gt;• date&lt;br/&gt;• evidence_refs[] (FK → Evidence.id)&lt;br/&gt;• rationale (markdown)&lt;br/&gt;• append-only (never updated, only appended)&lt;br/&gt;• triggered_extraction_id (FK → Pattern.id, nullable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="160" width="420" height="280" as="geometry" /></mxCell>
        <mxCell id="dimension" value="TaxonomyDimension&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• name (Need | Design Intent | Implementation Reality)&lt;br/&gt;• description&lt;br/&gt;• existing Forge node types[]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="loop" value="Loop&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• name (Outer | Inner | Hypothesis)&lt;br/&gt;• cadence (quarters-years | days-weeks | always-on)&lt;br/&gt;• description" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="600" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="authority" value="Authority&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• role (Leadership | Mission Stakeholder | PM | HCD Lead | HCD Expert | UX | Architect | Engineer | Research | Data Analyst)&lt;br/&gt;• decision_domain (markdown)&lt;br/&gt;• loop_id (FK → Loop.id)&lt;br/&gt;• replaceable_by_AI (bool — false for HCD)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="420" height="220" as="geometry" /></mxCell>
        <mxCell id="pattern" value="Pattern (extracted)&lt;br/&gt;──────────────&lt;br/&gt;• id (PK)&lt;br/&gt;• name&lt;br/&gt;• shape (component | token | IA | interaction | copy)&lt;br/&gt;• source_artifact_ids[] (FK → Artifact.id, ≥2)&lt;br/&gt;• extracted_at&lt;br/&gt;• extracted_by_authority_id (FK → Authority.id)&lt;br/&gt;• design_system_version_at_merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="600" width="420" height="220" as="geometry" /></mxCell>
        <mxCell id="rules_callout" value="INVARIANTS&lt;br/&gt;• Artifact.supersedes_id → forms a DAG (no cycles); old artifact stays as historical record&lt;br/&gt;• Artifact.status = SUPERSEDED iff another Artifact.supersedes_id = this.id&lt;br/&gt;• Hypothesis.status terminal-state (CONFIRMED/REFUTED/PARTIAL) requires ≥1 HypothesisOutcome record&lt;br/&gt;• HypothesisOutcome is append-only — outcome history is immutable&lt;br/&gt;• Pattern.source_artifact_ids requires ≥2 entries (one-off ≠ pattern)&lt;br/&gt;• Authority.replaceable_by_AI = false for HCD Expert (Aaron&#x27;s directive)&lt;br/&gt;• Artifact.dimension_id and loop_id are required (no orphans)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="1820" height="180" as="geometry" /></mxCell>
        <mxCell id="purpose_callout" value="Why this schema? Because the taxonomy must be MACHINE-READABLE at agent speed.&lt;br/&gt;Prose-only artifacts collapse into the human-speed slide-deck failure mode.&lt;br/&gt;A structured schema is the precondition for any tooling (`kata-design lint`, hypothesis-status CLI, pattern-extraction proposals) recommended in §11." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ede7f6;strokeColor=#5e35b1;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="1820" height="90" as="geometry" /></mxCell>
        <mxCell id="title-e61b60f6c02f486c" value="RIC-401 Appendix F — Artifact Schema (ERD)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1820" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle-e61b60f6c02f486c" value="Entity model for taxonomy artifacts. Versioning, lineage, hypothesis annotation, authority + dimension assignment. The schema underlies every appendix above." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1820" height="24" as="geometry" /></mxCell>
        <mxCell id="e1-e61b60f6c02f486c" value="1..N supersedes (lineage)" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="artifact" target="artifact"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="130" /><mxPoint x="30" y="130" /><mxPoint x="30" y="350" /></Array></mxGeometry></mxCell>
        <mxCell id="e2-e61b60f6c02f486c" value="0..1 has" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifact" target="hypothesis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-e61b60f6c02f486c" value="1..N collects" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hypothesis" target="evidence"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-e61b60f6c02f486c" value="1..N annotated by&lt;br/&gt;(append-only)" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hypothesis" target="outcome"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="130" /><mxPoint x="1670" y="130" /></Array></mxGeometry></mxCell>
        <mxCell id="e5-e61b60f6c02f486c" value="1..1 categorized as" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifact" target="dimension"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6-e61b60f6c02f486c" value="1..1 lives in" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifact" target="loop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="570" /></Array></mxGeometry></mxCell>
        <mxCell id="e7-e61b60f6c02f486c" value="1..1 owned by" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifact" target="authority"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="570" /><mxPoint x="1230" y="570" /></Array></mxGeometry></mxCell>
        <mxCell id="e8-e61b60f6c02f486c" value="0..1 triggers extraction&lt;br/&gt;(CONFIRMED only)" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=3;fontStyle=1;;" edge="1" parent="1" source="outcome" target="pattern"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9-e61b60f6c02f486c" value="many sources" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#e65100;dashed=1;;" edge="1" parent="1" source="pattern" target="artifact"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="870" /><mxPoint x="270" y="870" /></Array></mxGeometry></mxCell>
        <mxCell id="e10-e61b60f6c02f486c" value="collected by" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="evidence" target="authority"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="580" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
