{
  "title": "RIC-401 Authority Map — who decides what, in which loop",
  "subtitle": "AI cannot replace cross-discipline judgment. The taxonomy makes authorities visible at agent speed so judgment keeps up with code.",
  "viewBox": "0 0 2400 1500",
  "nodes": [
    {"id": "top_callout", "label": "AUTHORITY MAP — who decides what for each loop. The taxonomy makes these authorities visible at agent speed so judgment keeps up with code.", "kind": "data", "x": 60, "y": 40, "width": 2280, "height": 60, "style_overrides": "fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=14;"},

    {"id": "col1_header", "label": "OUTER LOOP — quarters → years", "kind": "data", "x": 60, "y": 130, "width": 700, "height": 50, "style_overrides": "fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;"},
    {"id": "col2_header", "label": "INNER LOOP — days → weeks", "kind": "data", "x": 820, "y": 130, "width": 700, "height": 50, "style_overrides": "fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;"},
    {"id": "col3_header", "label": "HYPOTHESIS LOOP — always-on", "kind": "data", "x": 1580, "y": 130, "width": 700, "height": 50, "style_overrides": "fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;"},

    {"id": "leadership",          "label": "LEADERSHIP\nDecisions: vision, program direction,\nbudget allocation\nOutputs: vision doc, strategic priorities", "kind": "process", "x": 60,   "y": 210, "width": 700, "height": 160},
    {"id": "mission_stakeholder", "label": "MISSION STAKEHOLDER (govt program owner)\nDecisions: ULTIMATE authority on\n\"what is good\" for this system\nOutputs: mission outcomes accepted/rejected,\ncontractual go-no-go",            "kind": "process", "x": 60,   "y": 390, "width": 700, "height": 160, "style_overrides": "fillColor=#ffe0b2;strokeColor=#e65100;fontStyle=1;fontSize=13;"},
    {"id": "hcd_lead",            "label": "HCD LEAD\nDecisions: design system principles, brand,\naccessibility baseline\nOutputs: DESIGN.md, design tokens,\nbase component library",                                          "kind": "process", "x": 60,   "y": 570, "width": 700, "height": 160, "style_overrides": "fillColor=#fce4ec;strokeColor=#ad1457;fontStyle=1;fontSize=13;"},

    {"id": "pm_inner",            "label": "PM (Product Manager)\nDecisions: mission-outcome judgment per feature,\nscope, prioritization, \"is this the right problem?\"\nOutputs: PRDs, epic breakdown, scope decisions",        "kind": "process", "x": 820,  "y": 210, "width": 700, "height": 160},
    {"id": "hcd_expert",          "label": "HCD EXPERT — IRREPLACEABLE\nDecisions: UX impact on specific user types,\naccessibility, end-user-pain validity,\nvisual design intent\nOutputs: wireframes, mockups, interaction specs", "kind": "process", "x": 820,  "y": 390, "width": 700, "height": 160, "style_overrides": "fillColor=#fce4ec;strokeColor=#ad1457;strokeWidth=3;fontStyle=1;fontSize=13;"},
    {"id": "ux",                  "label": "UX (Visual / Interaction Designer)\nDecisions: visual hierarchy, typography,\nspacing, motion\nOutputs: hi-fi mockups, design specs",                                                  "kind": "process", "x": 820,  "y": 570, "width": 700, "height": 160},
    {"id": "architect",           "label": "ARCHITECT\nDecisions: coupling, cohesion, ADR-level,\nstructural risk, \"are we boxing ourselves in?\"\nOutputs: ADRs, architectural review",                                        "kind": "process", "x": 820,  "y": 750, "width": 700, "height": 160},
    {"id": "engineer",            "label": "ENGINEER\nDecisions: feasibility, implementation reality,\ntechnical debt\nOutputs: shipped code, eng feasibility notes",                                                            "kind": "process", "x": 820,  "y": 930, "width": 700, "height": 160},

    {"id": "research",            "label": "RESEARCH (UX / User Research)\nDecisions: user-pain validity,\nhypothesis confirm/refute via\ninterviews + observation\nOutputs: research findings, usability tests",                "kind": "process", "x": 1580, "y": 210, "width": 700, "height": 160},
    {"id": "data_analyst",        "label": "DATA / ANALYST\nDecisions: telemetry interpretation,\nmetric validity, statistical significance\nOutputs: dashboards, hypothesis-outcome reports",                                  "kind": "process", "x": 1580, "y": 390, "width": 700, "height": 160},
    {"id": "pm_hypothesis",       "label": "PM (shared with Inner)\nDecisions: synthesizes research + data into\nmission-outcome verdict\nOutputs: kill criteria triggered,\npattern-extraction recommended",                     "kind": "process", "x": 1580, "y": 570, "width": 700, "height": 160, "style_overrides": "fillColor=#e8eaf6;strokeColor=#3949ab;dashed=1;fontStyle=1;fontSize=13;"},

    {"id": "right_callout", "label": "AI CANNOT REPLACE THESE AUTHORITIES.\nThe taxonomy ORIENTS AI + humans together;\nit does NOT replace cross-discipline judgment.\nHCD in particular is irreplaceable for\nvisual design impact on real users.", "kind": "data", "x": 1580, "y": 770, "width": 700, "height": 200, "style_overrides": "fillColor=#fce4ec;strokeColor=#ad1457;fontStyle=1;fontSize=13;"},

    {"id": "filter_callout", "label": "Pre-AI, implementation TOIL was a PASSIVE filter against bad direction (cheap features were scarce; toil filtered them).  Post-AI, EXPLICIT AUTHORITY ASSIGNMENT is the ACTIVE replacement filter.  Without authority visible at agent speed, teams ship fast in the wrong direction.", "kind": "data", "x": 60, "y": 1300, "width": 2220, "height": 90, "style_overrides": "fillColor=#ede7f6;strokeColor=#5e35b1;fontStyle=1;fontSize=13;"},

    {"id": "load_bearing_callout", "label": "PATTERN EXTRACTION (load-bearing)\nCONFIRMED outcomes feed Outer Design System", "kind": "data", "x": 60, "y": 1130, "width": 700, "height": 80, "style_overrides": "fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;"}
  ],
