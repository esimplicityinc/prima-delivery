<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="prima-delivery/diagramming" version="1.0">
  <diagram id="55f9d8dd5bc9431d" name="RIC-401 Appendix D — Artifact Update Protocols">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="top_callout" value="ARTIFACT UPDATE PROTOCOLS — &quot;Design is never done.&quot;  Every artifact is versioned, status-tracked, lineage-preserving.&lt;br/&gt;Decide UPDATE-IN-PLACE vs SUPERSEDE vs ANNOTATE vs EXTRACT based on the change shape." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1680" height="60" as="geometry" /></mxCell>
        <mxCell id="trigger" value="Change to a design intent artifact" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontSize=14;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="decision_kind" value="What KIND of change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="270" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="refinement" value="REFINEMENT&lt;br/&gt;(small additive change:&lt;br/&gt;type the field tighter,&lt;br/&gt;add an example, sharper UT description)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="major_shift" value="MAJOR SHIFT&lt;br/&gt;(replaces the approach:&lt;br/&gt;whole-feature redesign, new UT,&lt;br/&gt;IA restructure, ADR contradiction)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="1"><mxGeometry x="480" y="460" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="outcome_flip" value="HYPOTHESIS OUTCOME&lt;br/&gt;(user data flipped status to&lt;br/&gt;CONFIRMED / REFUTED / PARTIAL&lt;br/&gt;with new evidence)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff9c4;strokeColor=#f57f17;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="confirmed_pattern" value="CONFIRMED PATTERN EMERGES&lt;br/&gt;(multiple inner-loop wins&lt;br/&gt;show the same shape;&lt;br/&gt;ready to promote to outer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="460" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="in_place" value="UPDATE IN PLACE&lt;br/&gt;• bump version (1.0 → 1.1)&lt;br/&gt;• update last_modified&lt;br/&gt;• preserve hypothesis_id + supersedes_id (stay)&lt;br/&gt;• git commit with refinement summary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="360" height="160" as="geometry" /></mxCell>
        <mxCell id="supersede" value="SUPERSEDE WITH LINEAGE&lt;br/&gt;• create NEW artifact (1.0 → 2.0)&lt;br/&gt;• new artifact has supersedes_id = old.id&lt;br/&gt;• OLD artifact stays — never deleted&lt;br/&gt;• status of old: SUPERSEDED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="1"><mxGeometry x="480" y="660" width="360" height="180" as="geometry" /></mxCell>
        <mxCell id="annotate" value="ANNOTATE WITH OUTCOME&lt;br/&gt;• append outcome record:&lt;br/&gt;  status, date, evidence_refs[]&lt;br/&gt;• append-only — old annotations&lt;br/&gt;  stay (audit trail)&lt;br/&gt;• may trigger SUPERSEDE if REFUTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff9c4;strokeColor=#f57f17;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="360" height="180" as="geometry" /></mxCell>
        <mxCell id="extract" value="EXTRACT PATTERN to OUTER&lt;br/&gt;• distill the reusable shape&lt;br/&gt;• propose to design system (DESIGN.md)&lt;br/&gt;• HCD lead + architect review&lt;br/&gt;• merge → version-bump design system&lt;br/&gt;• notify other tenants" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="660" width="360" height="180" as="geometry" /></mxCell>
        <mxCell id="common_rules" value="ALWAYS:&lt;br/&gt;• version + last_modified on every artifact&lt;br/&gt;• status field: DRAFT / APPROVED / SUPERSEDED / DEPRECATED — never silent deletion&lt;br/&gt;• CHANGELOG.md alongside design system (treat like code)&lt;br/&gt;• PR review for any artifact change (treat docs like code)&lt;br/&gt;• stale-detection cadence: quarterly design system audit, annual UT review with current research" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="820" height="200" as="geometry" /></mxCell>
        <mxCell id="never_rules" value="NEVER:&lt;br/&gt;• silent overwrite (UPDATE IN PLACE for refinements only — never to mask a major shift)&lt;br/&gt;• delete superseded artifacts (lineage matters; the audit trail is the artifact)&lt;br/&gt;• change status without dated evidence (CONFIRMED with no metrics is theater)&lt;br/&gt;• extract a pattern without ≥2 confirmed instances (one-off ≠ pattern)&lt;br/&gt;• promote outer-loop changes without HCD lead + architect review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ffebee;strokeColor=#b71c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="880" width="820" height="200" as="geometry" /></mxCell>
        <mxCell id="extract_emphasis" value="EXTRACT is the LOAD-BEARING update.&lt;br/&gt;It&#x27;s how the Outer Design System grows from&lt;br/&gt;inner-loop wins, keeping the system LIVING.&lt;br/&gt;Without extraction, the design system ossifies." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="1110" width="360" height="110" as="geometry" /></mxCell>
        <mxCell id="title-55f9d8dd5bc9431d" value="RIC-401 Appendix D — Artifact Update Protocols" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1720" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle-55f9d8dd5bc9431d" value="How design intent artifacts stay alive at agent speed: in-place refinement, supersession with lineage, hypothesis-outcome annotation, pattern extraction." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1720" height="24" as="geometry" /></mxCell>
        <mxCell id="e1-55f9d8dd5bc9431d" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trigger" target="decision_kind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-55f9d8dd5bc9431d" value="small + additive" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision_kind" target="refinement"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="e3-55f9d8dd5bc9431d" value="replaces approach" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision_kind" target="major_shift"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="e4-55f9d8dd5bc9431d" value="outcome flipped" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision_kind" target="outcome_flip"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="e5-55f9d8dd5bc9431d" value="pattern stable" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision_kind" target="confirmed_pattern"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="e6-55f9d8dd5bc9431d" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="refinement" target="in_place"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7-55f9d8dd5bc9431d" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="major_shift" target="supersede"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8-55f9d8dd5bc9431d" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="outcome_flip" target="annotate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9-55f9d8dd5bc9431d" value="PATTERN EXTRACTION" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;;" edge="1" parent="1" source="confirmed_pattern" target="extract"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10-55f9d8dd5bc9431d" value="if REFUTED &amp; redesign needed" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="annotate" target="supersede"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
