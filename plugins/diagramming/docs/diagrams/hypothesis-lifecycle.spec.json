{
  "title": "RIC-401 Appendix C — Hypothesis Lifecycle (state machine)",
  "subtitle": "DRAFT → ACTIVE → {CONFIRMED, REFUTED, PARTIAL} → {EXTRACTED, KILLED, REFINED}. Every shipped feature is a hypothesis with a finite life.",
  "viewBox": "0 0 1800 1100",
  "nodes": [
    {"id": "top_callout", "label": "HYPOTHESIS LIFECYCLE — every shipped feature passes through these states.\nKill criteria + success metrics are defined PRE-ship; outcomes flip the artifact's status with date + evidence.", "kind": "data", "x": 60, "y": 40, "width": 1680, "height": 60, "style_overrides": "fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=13;"},

    {"id": "draft",     "label": "DRAFT\nclaim authored;\nmetrics + kill criteria proposed",                "kind": "process",   "x": 60,   "y": 200, "width": 280, "height": 110},
    {"id": "active",    "label": "ACTIVE\ntelemetry instrumented;\nfeature shipped;\nclock starts",          "kind": "process",   "x": 460,  "y": 200, "width": 280, "height": 110, "style_overrides": "fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=3;fontStyle=1;"},

    {"id": "confirmed", "label": "CONFIRMED\nsuccess metrics fired\nbefore kill date",                       "kind": "process",   "x": 880,  "y": 60,  "width": 260, "height": 110, "style_overrides": "fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;"},
    {"id": "partial",   "label": "PARTIAL\nsignal mixed;\nneither confirm nor kill",                          "kind": "process",   "x": 880,  "y": 230, "width": 260, "height": 110, "style_overrides": "fillColor=#fff9c4;strokeColor=#f57f17;fontStyle=1;"},
    {"id": "refuted",   "label": "REFUTED\nkill criteria fired\n(or kill date passed)",                       "kind": "process",   "x": 880,  "y": 400, "width": 260, "height": 110, "style_overrides": "fillColor=#ffcdd2;strokeColor=#c62828;fontStyle=1;"},

    {"id": "extracted", "label": "EXTRACTED\npattern absorbed into\nOuter Design System",                     "kind": "process",   "x": 1280, "y": 60,  "width": 280, "height": 110, "style_overrides": "fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;fontSize=14;"},
    {"id": "refined",   "label": "REFINED\nrefactor metrics or\nrescope; new hypothesis",                     "kind": "process",   "x": 1280, "y": 230, "width": 280, "height": 110},
    {"id": "killed",    "label": "KILLED\nfeature deprecated /\nrolled back",                                 "kind": "process",   "x": 1280, "y": 400, "width": 280, "height": 110, "style_overrides": "fillColor=#eceff1;strokeColor=#37474f;"},

    {"id": "extract_callout", "label": "PATTERN EXTRACTION (load-bearing)\nCONFIRMED → EXTRACTED is THE mechanism\nthat keeps the Outer Design System living", "kind": "data", "x": 1280, "y": 600, "width": 280, "height": 110, "style_overrides": "fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;"},
    {"id": "kill_callout", "label": "Kill criteria are defined PRE-ship.\nWithout them, REFUTED has no\noperational meaning.", "kind": "data", "x": 880, "y": 600, "width": 260, "height": 100, "style_overrides": "fillColor=#ffebee;strokeColor=#b71c1c;fontSize=12;"},
    {"id": "redesign_callout", "label": "REFUTED + REFINED → DRAFT (loop)\nThe spike's most-traveled feedback edge.\nRefuted hypotheses become next cycle's\nstarting point — never disappear without trace.", "kind": "data", "x": 60, "y": 600, "width": 600, "height": 110, "style_overrides": "fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=12;"},

    {"id": "annotation_rule", "label": "ARTIFACT ANNOTATION RULE\nWhen a state transitions, the related artifact (PRD, mockup, ADR) gets a hypothesis-outcome annotation:\n  status: CONFIRMED | REFUTED | PARTIAL\n  date: <ISO 8601>\n  evidence: <links to research findings, telemetry dashboards, interviews>\nArtifacts are NEVER silently updated. The annotation IS the audit trail.", "kind": "data", "x": 60, "y": 850, "width": 1680, "height": 130, "style_overrides": "fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;"}
  ],
  "arrows": [
    {"source": "draft",  "target": "active",   "label": "approve + ship", "kind": "control", "exit_port": "R", "entry_port": "L"},
    {"source": "active", "target": "confirmed","label": "success metrics fire", "kind": "control", "exit_port": "R", "entry_port": "L", "style_overrides": "strokeColor=#2e7d32;"},
    {"source": "active", "target": "partial",  "label": "mixed signal", "kind": "control", "exit_port": "R", "entry_port": "L"},
    {"source": "active", "target": "refuted",  "label": "kill criteria fire", "kind": "control", "exit_port": "R", "entry_port": "L", "style_overrides": "strokeColor=#c62828;"},

    {"source": "confirmed", "target": "extracted", "label": "PATTERN EXTRACTION", "kind": "control", "exit_port": "R", "entry_port": "L", "style_overrides": "strokeColor=#e65100;strokeWidth=4;fontStyle=1;"},
    {"source": "partial",   "target": "refined",   "label": "iterate scope", "kind": "control", "exit_port": "R", "entry_port": "L"},
    {"source": "refuted",   "target": "killed",    "label": "deprecate / rollback", "kind": "control", "exit_port": "R", "entry_port": "L"},

    {"source": "refined", "target": "draft", "label": "back to drawing board", "kind": "feedback", "exit_port": "B", "entry_port": "B", "waypoints": [{"x": 1420, "y": 800}, {"x": 200, "y": 800}], "style_overrides": "dashed=1;"},
    {"source": "refuted", "target": "draft", "label": "redesign + new hypothesis", "kind": "feedback", "exit_port": "B", "entry_port": "B", "waypoints": [{"x": 1010, "y": 770}, {"x": 200, "y": 770}], "style_overrides": "strokeColor=#c62828;dashed=1;"}
  ]
}
