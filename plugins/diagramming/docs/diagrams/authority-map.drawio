<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="prima-delivery/diagramming" version="1.0">
  <diagram id="ad2af9d27b97428d" name="RIC-401 Authority Map — who decides what, in which loop">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="top_callout" value="AUTHORITY MAP — who decides what for each loop. The taxonomy makes these authorities visible at agent speed so judgment keeps up with code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="2280" height="60" as="geometry" /></mxCell>
        <mxCell id="col1_header" value="OUTER LOOP — quarters → years" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="col2_header" value="INNER LOOP — days → weeks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="col3_header" value="HYPOTHESIS LOOP — always-on" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="130" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="leadership" value="LEADERSHIP&lt;br/&gt;Decisions: vision, program direction,&lt;br/&gt;budget allocation&lt;br/&gt;Outputs: vision doc, strategic priorities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="mission_stakeholder" value="MISSION STAKEHOLDER (govt program owner)&lt;br/&gt;Decisions: ULTIMATE authority on&lt;br/&gt;&quot;what is good&quot; for this system&lt;br/&gt;Outputs: mission outcomes accepted/rejected,&lt;br/&gt;contractual go-no-go" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#ffe0b2;strokeColor=#e65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="hcd_lead" value="HCD LEAD&lt;br/&gt;Decisions: design system principles, brand,&lt;br/&gt;accessibility baseline&lt;br/&gt;Outputs: DESIGN.md, design tokens,&lt;br/&gt;base component library" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="pm_inner" value="PM (Product Manager)&lt;br/&gt;Decisions: mission-outcome judgment per feature,&lt;br/&gt;scope, prioritization, &quot;is this the right problem?&quot;&lt;br/&gt;Outputs: PRDs, epic breakdown, scope decisions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="820" y="210" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="hcd_expert" value="HCD EXPERT — IRREPLACEABLE&lt;br/&gt;Decisions: UX impact on specific user types,&lt;br/&gt;accessibility, end-user-pain validity,&lt;br/&gt;visual design intent&lt;br/&gt;Outputs: wireframes, mockups, interaction specs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;strokeWidth=3;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="390" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="ux" value="UX (Visual / Interaction Designer)&lt;br/&gt;Decisions: visual hierarchy, typography,&lt;br/&gt;spacing, motion&lt;br/&gt;Outputs: hi-fi mockups, design specs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="820" y="570" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="architect" value="ARCHITECT&lt;br/&gt;Decisions: coupling, cohesion, ADR-level,&lt;br/&gt;structural risk, &quot;are we boxing ourselves in?&quot;&lt;br/&gt;Outputs: ADRs, architectural review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="820" y="750" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="engineer" value="ENGINEER&lt;br/&gt;Decisions: feasibility, implementation reality,&lt;br/&gt;technical debt&lt;br/&gt;Outputs: shipped code, eng feasibility notes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="820" y="930" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="research" value="RESEARCH (UX / User Research)&lt;br/&gt;Decisions: user-pain validity,&lt;br/&gt;hypothesis confirm/refute via&lt;br/&gt;interviews + observation&lt;br/&gt;Outputs: research findings, usability tests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1580" y="210" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="data_analyst" value="DATA / ANALYST&lt;br/&gt;Decisions: telemetry interpretation,&lt;br/&gt;metric validity, statistical significance&lt;br/&gt;Outputs: dashboards, hypothesis-outcome reports" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1580" y="390" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="pm_hypothesis" value="PM (shared with Inner)&lt;br/&gt;Decisions: synthesizes research + data into&lt;br/&gt;mission-outcome verdict&lt;br/&gt;Outputs: kill criteria triggered,&lt;br/&gt;pattern-extraction recommended" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#e8eaf6;strokeColor=#3949ab;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="570" width="700" height="160" as="geometry" /></mxCell>
        <mxCell id="right_callout" value="AI CANNOT REPLACE THESE AUTHORITIES.&lt;br/&gt;The taxonomy ORIENTS AI + humans together;&lt;br/&gt;it does NOT replace cross-discipline judgment.&lt;br/&gt;HCD in particular is irreplaceable for&lt;br/&gt;visual design impact on real users." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fce4ec;strokeColor=#ad1457;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="770" width="700" height="200" as="geometry" /></mxCell>
        <mxCell id="filter_callout" value="Pre-AI, implementation TOIL was a PASSIVE filter against bad direction (cheap features were scarce; toil filtered them).  Post-AI, EXPLICIT AUTHORITY ASSIGNMENT is the ACTIVE replacement filter.  Without authority visible at agent speed, teams ship fast in the wrong direction." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ede7f6;strokeColor=#5e35b1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="2220" height="90" as="geometry" /></mxCell>
        <mxCell id="load_bearing_callout" value="PATTERN EXTRACTION (load-bearing)&lt;br/&gt;CONFIRMED outcomes feed Outer Design System" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="700" height="80" as="geometry" /></mxCell>
        <mxCell id="title-ad2af9d27b97428d" value="RIC-401 Authority Map — who decides what, in which loop" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2320" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle-ad2af9d27b97428d" value="AI cannot replace cross-discipline judgment. The taxonomy makes authorities visible at agent speed so judgment keeps up with code." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="2320" height="24" as="geometry" /></mxCell>
        <mxCell id="e1-ad2af9d27b97428d" value="1. mission outcomes&lt;br/&gt;constrain feature scope" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mission_stakeholder" target="pm_inner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-ad2af9d27b97428d" value="2. design system&lt;br/&gt;informs feature design" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hcd_lead" target="hcd_expert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-ad2af9d27b97428d" value="3. through-line&lt;br/&gt;(same role, both loops)" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="pm_inner" target="pm_hypothesis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-ad2af9d27b97428d" value="4. UX hypothesis&lt;br/&gt;emitted at ship" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hcd_expert" target="research"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5-ad2af9d27b97428d" value="5. ships telemetry&lt;br/&gt;that Data interprets" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engineer" target="data_analyst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6-ad2af9d27b97428d" value="6. design intent&lt;br/&gt;carries to features" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hcd_lead" target="architect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="650" /><mxPoint x="790" y="830" /></Array></mxGeometry></mxCell>
        <mxCell id="e7-ad2af9d27b97428d" value="7. REFUTED — rethink Need" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#c62828;fontStyle=1;dashed=1;;" edge="1" parent="1" source="research" target="mission_stakeholder"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="290" /><mxPoint x="1540" y="100" /><mxPoint x="410" y="100" /><mxPoint x="410" y="390" /></Array></mxGeometry></mxCell>
        <mxCell id="e8-ad2af9d27b97428d" value="REFUTED — rethink Need" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c62828;dashed=1;;" edge="1" parent="1" source="data_analyst" target="mission_stakeholder"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="470" /><mxPoint x="30" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e9-ad2af9d27b97428d" value="8. CONFIRMED — PATTERN EXTRACTION&lt;br/&gt;(load-bearing)" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;fontSize=14;;" edge="1" parent="1" source="research" target="hcd_lead"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1930" y="1240" /><mxPoint x="410" y="1240" /><mxPoint x="410" y="770" /></Array></mxGeometry></mxCell>
        <mxCell id="e10-ad2af9d27b97428d" value="CONFIRMED — pattern extraction" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=3;;" edge="1" parent="1" source="data_analyst" target="hcd_lead"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1930" y="1250" /><mxPoint x="770" y="1250" /><mxPoint x="770" y="650" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
