<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="prima-delivery/diagramming" version="1.0">
  <diagram id="f507ef84002b4d22" name="RIC-401 Appendix E — Pattern Extraction Pipeline">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="top_callout" value="PATTERN EXTRACTION — the most valuable artifact update.&lt;br/&gt;When a pattern works in inner loop, it gets PULLED BACK into the outer-loop design system.&lt;br/&gt;Without this, the design system is dead the moment it&#x27;s authored. WITH this, it grows from every shipped feature." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1680" height="80" as="geometry" /></mxCell>
        <mxCell id="src_inner" value="Inner Loop&lt;br/&gt;feature ships" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="src_hyp" value="Hypothesis Loop&lt;br/&gt;outcome: CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="step1" value="1. IDENTIFY&lt;br/&gt;Is the pattern observable in ≥2 features?&lt;br/&gt;(Single instance ≠ pattern)&lt;br/&gt;Owner: HCD Expert / Architect" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step2" value="2. DISTILL&lt;br/&gt;Name the reusable shape:&lt;br/&gt;• component / token / IA pattern&lt;br/&gt;• interaction primitive&lt;br/&gt;• copy convention&lt;br/&gt;Strip feature-specific details." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step3" value="3. PROPOSE&lt;br/&gt;Write proposal: pattern + 2+ examples +&lt;br/&gt;rationale + suggested API.&lt;br/&gt;File: PR against design system repo.&lt;br/&gt;Owner: pattern&#x27;s discoverer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step4" value="4. REVIEW&lt;br/&gt;HCD Lead: visual + UX coherence&lt;br/&gt;Architect: API + coupling&lt;br/&gt;Mission Stakeholder: alignment&lt;br/&gt;→ APPROVE / REVISE / REJECT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="1"><mxGeometry x="1440" y="200" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step5" value="5. MERGE&lt;br/&gt;• add to design system / component lib&lt;br/&gt;• version-bump (e.g. DESIGN.md 2.3 → 2.4)&lt;br/&gt;• update CHANGELOG.md&lt;br/&gt;• tag the pattern with source feature(s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="460" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step6" value="6. NOTIFY&lt;br/&gt;• broadcast to all tenants&lt;br/&gt;  (FOE, RIC, Prima, SHINE)&lt;br/&gt;• update onboarding docs&lt;br/&gt;• mention in next sprint review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="step7" value="7. ADOPT&lt;br/&gt;• other tenants pull the pattern&lt;br/&gt;• existing features migrate over time&lt;br/&gt;  (deprecation notices on old patterns)&lt;br/&gt;• track adoption rate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="720" y="460" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="outcome" value="Outer Design System&lt;br/&gt;grows by ONE pattern.&lt;br/&gt;Next extraction starts from&lt;br/&gt;the new baseline." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="460" width="320" height="200" as="geometry" /></mxCell>
        <mxCell id="loopback_callout" value="Outer Design System NOW informs&lt;br/&gt;the NEXT inner-loop feature&lt;br/&gt;that starts from a richer baseline.&lt;br/&gt;(This is the spike&#x27;s spine: pattern&lt;br/&gt;extraction is what makes loops nest.)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="240" height="200" as="geometry" /></mxCell>
        <mxCell id="anti_pattern" value="ANTI-PATTERNS (skip these and the system rots):&lt;br/&gt;• extracting one-off as if it&#x27;s a pattern (need ≥2 confirmed instances)&lt;br/&gt;• extracting without HCD-lead review (taste collapses)&lt;br/&gt;• extracting without notifying other tenants (silent fragmentation)&lt;br/&gt;• extracting without adoption tracking (dead patterns clutter the system)&lt;br/&gt;• not deprecating old patterns when new ones replace them (system grows forever)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ffebee;strokeColor=#b71c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1700" height="160" as="geometry" /></mxCell>
        <mxCell id="cadence_callout" value="CADENCE: extraction is opportunistic, not scheduled.&lt;br/&gt;Trigger is the ≥2-instance signal, not the calendar.&lt;br/&gt;Quarterly design system audit catches missed extractions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1700" height="70" as="geometry" /></mxCell>
        <mxCell id="title-f507ef84002b4d22" value="RIC-401 Appendix E — Pattern Extraction Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1720" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle-f507ef84002b4d22" value="How inner-loop wins flow back into outer-loop design system. The load-bearing mechanism that keeps the design system LIVING." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1720" height="24" as="geometry" /></mxCell>
        <mxCell id="e1-f507ef84002b4d22" value="trigger" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src_inner" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-f507ef84002b4d22" value="CONFIRMED" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2e7d32;strokeWidth=2;;" edge="1" parent="1" source="src_hyp" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6-f507ef84002b4d22" value="APPROVED" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#2e7d32;fontStyle=1;;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7-f507ef84002b4d22" value="REVISE" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="step4" target="step3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="160" /><mxPoint x="1240" y="160" /></Array></mxGeometry></mxCell>
        <mxCell id="e8-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10-f507ef84002b4d22" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step7" target="outcome"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11-f507ef84002b4d22" value="next pattern starts here" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="outcome" target="step1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="430" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
