<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="prima-delivery/diagramming" version="1.0">
  <diagram id="7218719080b747fb" name="RIC-401 Appendix C — Hypothesis Lifecycle (state machine)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="top_callout" value="HYPOTHESIS LIFECYCLE — every shipped feature passes through these states.&lt;br/&gt;Kill criteria + success metrics are defined PRE-ship; outcomes flip the artifact&#x27;s status with date + evidence." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1680" height="60" as="geometry" /></mxCell>
        <mxCell id="draft" value="DRAFT&lt;br/&gt;claim authored;&lt;br/&gt;metrics + kill criteria proposed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="active" value="ACTIVE&lt;br/&gt;telemetry instrumented;&lt;br/&gt;feature shipped;&lt;br/&gt;clock starts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="confirmed" value="CONFIRMED&lt;br/&gt;success metrics fired&lt;br/&gt;before kill date" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="partial" value="PARTIAL&lt;br/&gt;signal mixed;&lt;br/&gt;neither confirm nor kill" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff9c4;strokeColor=#f57f17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="refuted" value="REFUTED&lt;br/&gt;kill criteria fired&lt;br/&gt;(or kill date passed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#ffcdd2;strokeColor=#c62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="extracted" value="EXTRACTED&lt;br/&gt;pattern absorbed into&lt;br/&gt;Outer Design System" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1280" y="60" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="refined" value="REFINED&lt;br/&gt;refactor metrics or&lt;br/&gt;rescope; new hypothesis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="230" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="killed" value="KILLED&lt;br/&gt;feature deprecated /&lt;br/&gt;rolled back" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;fontStyle=1;shadow=0;;fillColor=#eceff1;strokeColor=#37474f;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="extract_callout" value="PATTERN EXTRACTION (load-bearing)&lt;br/&gt;CONFIRMED → EXTRACTED is THE mechanism&lt;br/&gt;that keeps the Outer Design System living" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="600" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="kill_callout" value="Kill criteria are defined PRE-ship.&lt;br/&gt;Without them, REFUTED has no&lt;br/&gt;operational meaning." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ffebee;strokeColor=#b71c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="redesign_callout" value="REFUTED + REFINED → DRAFT (loop)&lt;br/&gt;The spike&#x27;s most-traveled feedback edge.&lt;br/&gt;Refuted hypotheses become next cycle&#x27;s&lt;br/&gt;starting point — never disappear without trace." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="annotation_rule" value="ARTIFACT ANNOTATION RULE&lt;br/&gt;When a state transitions, the related artifact (PRD, mockup, ADR) gets a hypothesis-outcome annotation:&lt;br/&gt;  status: CONFIRMED | REFUTED | PARTIAL&lt;br/&gt;  date: &lt;ISO 8601&gt;&lt;br/&gt;  evidence: &lt;links to research findings, telemetry dashboards, interviews&gt;&lt;br/&gt;Artifacts are NEVER silently updated. The annotation IS the audit trail." style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;fontStyle=1;;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1680" height="130" as="geometry" /></mxCell>
        <mxCell id="title-7218719080b747fb" value="RIC-401 Appendix C — Hypothesis Lifecycle (state machine)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1720" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle-7218719080b747fb" value="DRAFT → ACTIVE → {CONFIRMED, REFUTED, PARTIAL} → {EXTRACTED, KILLED, REFINED}. Every shipped feature is a hypothesis with a finite life." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1720" height="24" as="geometry" /></mxCell>
        <mxCell id="e1-7218719080b747fb" value="approve + ship" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="draft" target="active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2-7218719080b747fb" value="success metrics fire" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2e7d32;;" edge="1" parent="1" source="active" target="confirmed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3-7218719080b747fb" value="mixed signal" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="active" target="partial"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4-7218719080b747fb" value="kill criteria fire" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c62828;;" edge="1" parent="1" source="active" target="refuted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5-7218719080b747fb" value="PATTERN EXTRACTION" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#e65100;strokeWidth=4;fontStyle=1;;" edge="1" parent="1" source="confirmed" target="extracted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6-7218719080b747fb" value="iterate scope" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="partial" target="refined"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7-7218719080b747fb" value="deprecate / rollback" style="endArrow=classic;html=1;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=12;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="refuted" target="killed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8-7218719080b747fb" value="back to drawing board" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;dashed=1;;" edge="1" parent="1" source="refined" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="800" /><mxPoint x="200" y="800" /></Array></mxGeometry></mxCell>
        <mxCell id="e9-7218719080b747fb" value="redesign + new hypothesis" style="endArrow=classic;html=1;rounded=1;curved=1;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;fontStyle=2;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#c62828;dashed=1;;" edge="1" parent="1" source="refuted" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="770" /><mxPoint x="200" y="770" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
